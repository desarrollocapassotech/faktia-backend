# Neon: DATABASE_URL con pooler (runtime), DIRECT_URL sin pooler (migraciones)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/facturador?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/facturador?sslmode=require"

# Sesión: al menos 32 caracteres aleatorios (node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Cifrado de certificados ARCA (AES-256-GCM). Al menos 32 caracteres. Tiene que ser la misma en
# todos los entornos que compartan base: si cambia, los certificados guardados no se pueden leer.
FAKTIA_ENCRYPTION_KEY=""

# Token de AfipSDK (app.afipsdk.com). Sin esto el backend arranca pero no puede emitir.
AFIP_SDK_API_KEY=""

# Padrón de ARCA (ws_sr_constancia_inscripcion) con un certificado de plataforma: valida CUITs y
# autocompleta datos del emisor y de clientes para todas las empresas, aunque estén en pruebas.
# Mismo esquema que Vialto (se puede usar el mismo certificado). Sin estas variables se completa a mano.
PADRON_AFIP_SDK_API_KEY=""   # token de una cuenta de AfipSDK aparte, para no gastar la cuota de facturación
PADRON_CUIT=""               # CUIT dueño del certificado
PADRON_CERT=""               # certificado PEM (una línea con \n literales)
PADRON_KEY=""                # clave privada PEM (una línea con \n literales)

# Origen del frontend permitido por CORS (separar varios con coma)
FRONTEND_URL="http://localhost:5173"
PORT=3000

# Email (avisos de vencimientos). Sin SMTP_HOST y SMTP_FROM los emails solo se registran en el log.
# EMAIL_TRANSPORTE=log los fuerza a log aunque haya SMTP; EMAIL_TRANSPORTE=smtp exige SMTP al arrancar.
EMAIL_TRANSPORTE=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""          # true para el puerto 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""            # ej. "Faktia <avisos@faktia.com.ar>"
