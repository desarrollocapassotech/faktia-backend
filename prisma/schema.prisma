// Esquema completo de referencia: ARCHITECTURE.md §5.
// Cada fase agrega sus modelos con su propia migración.
// Relaciones entre entidades del mismo tenant: FK compuesta (tenantId, id), así la base
// impide que un registro apunte a otro de un tenant distinto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum AmbienteArca {
  HOMOLOGACION
  PRODUCCION
}

/// Código ARCA en comentario (CondicionIVAReceptorId / condición del emisor).
enum CondicionIva {
  RESPONSABLE_INSCRIPTO // 1
  EXENTO // 4
  CONSUMIDOR_FINAL // 5
  MONOTRIBUTO // 6
  NO_CATEGORIZADO // 7
  PROVEEDOR_EXTERIOR // 8
  CLIENTE_EXTERIOR // 9
  IVA_LIBERADO // 10
  MONOTRIBUTO_SOCIAL // 13
  NO_ALCANZADO // 15
  MONOTRIBUTO_TIP // 16 Monotributista trabajador independiente promovido
}

enum TipoDocumento {
  CUIT // 80
  CUIL // 86
  DNI // 96
  PASAPORTE // 94
  CONSUMIDOR_FINAL // 99 (DocNro 0)
}

enum TipoComprobante {
  FACTURA_A // 1
  NOTA_DEBITO_A // 2
  NOTA_CREDITO_A // 3
  FACTURA_B // 6
  NOTA_DEBITO_B // 7
  NOTA_CREDITO_B // 8
  FACTURA_C // 11
  NOTA_DEBITO_C // 12
  NOTA_CREDITO_C // 13
}

enum ConceptoArca {
  PRODUCTOS // 1
  SERVICIOS // 2 → exige FchServDesde/Hasta y FchVtoPago
  PRODUCTOS_Y_SERVICIOS // 3 → ídem
}

enum Moneda {
  ARS // ARCA "PES"
  USD // ARCA "DOL"
}

enum EstadoComprobante {
  BORRADOR // editable; nada fue a ARCA
  EMITIENDO // bloqueado; hay una llamada a ARCA en curso
  PENDIENTE_VERIFICACION // se cortó la comunicación; hay número reservado; se resuelve con FECompConsultar
  EMITIDO // tiene CAE
  RECHAZADO // ARCA rechazó o falló antes de enviar; vuelve a ser editable
  ANULADO // factura compensada totalmente por NC emitida
}

enum UnidadItem {
  HORA
  UNIDAD
  SERVICIO
  MES
}

enum OrigenItem {
  TRACKER
  API
  EXCEL
  MANUAL
}

enum EstadoItem {
  VALIDO // listo para agrupar en un borrador
  CON_ERRORES // falta cliente, precio, etc. (ver `errores`)
  DUPLICADO // otro ítem ya tiene la misma (origen, referenciaExterna) — solo en el resumen del lote
  EN_BORRADOR // asignado a un comprobante en BORRADOR
  FACTURADO // su comprobante fue EMITIDO
  DESCARTADO // el usuario lo descartó
}

enum EstadoImportacion {
  EN_STAGING
  CONFIRMADA
  DESCARTADA
  FALLIDA
}

enum EstadoWebhookEntrega {
  PENDIENTE
  ENTREGADA
  FALLIDA // agotó reintentos
}

// ─────────────────────────────── Tenants ───────────────────────────────

model Tenant {
  id                     String        @id @default(cuid())
  slug                   String        @unique
  nombreFantasia         String
  // Datos fiscales: null en una empresa recién registrada; se completan en Configuración
  // y son obligatorios para facturar (TenantsService.obtenerEmisorCompleto).
  razonSocial            String?
  cuit                   String?       @unique // 11 dígitos, sin guiones
  condicionIva           CondicionIva?
  domicilioFiscal        String?
  ingresosBrutos         String?
  inicioActividades      DateTime?     @db.Date
  // Campos del emisor que salieron del padrón de ARCA ("razonSocial" | "condicionIva" |
  // "domicilioFiscal"): no se editan a mano (PadronEmisorService).
  camposDeArca           String[]      @default([])
  padronVerificadoEn     DateTime?
  ambienteArca           AmbienteArca  @default(HOMOLOGACION)
  // Contacto que va en el encabezado de los documentos (presupuestos, recibos, listados).
  telefono               String?
  emailContacto          String?
  // Módulos habilitados (shared/modulos/modulos.ts). El menú y el AuthGuard (@Modulo) los respetan.
  modulosHabilitados     String[]      @default(["comprobantes", "recibos", "recibos-pago", "cuenta-corriente", "proyectos", "presupuestos", "materiales", "importaciones", "integraciones", "webhooks"])
  // Cómo se llama la entidad Proyecto en pantalla y en los documentos (para Ale Herrería: "Obra" / "Obras").
  etiquetaProyecto       String        @default("Proyecto")
  etiquetaProyectoPlural String        @default("Proyectos")
  // Resumen diario por email a los usuarios con lo vencido y lo que vence en los próximos días.
  avisosEmail            Boolean       @default(true)
  diasAvisoVencimiento   Int           @default(3)
  // Validez por defecto de un presupuesto nuevo (días desde su fecha).
  diasValidezPresupuesto Int           @default(15)
  activo                 Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  usuarios              Usuario[]
  integraciones         Integracion[]
  tokensAcceso          TokenAcceso[]
  puntosVenta           PuntoVenta[]
  certificados          CertificadoArca[]
  plantillaPdf          PlantillaPdf?
  clientes              Cliente[]
  referenciasClientes   ClienteReferenciaExterna[]
  tarifas               Tarifa[]
  plantillasMapeo       PlantillaMapeo[]
  importaciones         Importacion[]
  items                 ItemFacturable[]
  comprobantes          Comprobante[]
  lineas                ComprobanteLinea[]
  alicuotas             ComprobanteAlicuota[]
  arcaLogs              ArcaLog[]
  solicitudesIdem       SolicitudIdempotente[]
  webhookSuscripciones  WebhookSuscripcion[]
  webhookEntregas       WebhookEntrega[]
  recibos               Recibo[]
  movimientosCc         MovimientoCuentaCorriente[]
  imputacionesCc        ImputacionCuentaCorriente[]
  proyectos             Proyecto[]
  certificaciones       CertificacionHito[]
  avisosEnviados        AvisoEmail[]
  presupuestos          Presupuesto[]
  presupuestoItems      PresupuestoItem[]
  itemsBiblioteca       ItemBiblioteca[]
  observacionesCatalogo ObservacionCatalogo[]

  @@map("tenants")
}

model PuntoVenta {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero      Int
  ambiente    AmbienteArca
  descripcion String?
  activo      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  comprobantes Comprobante[]

  @@unique([tenantId, id])
  @@unique([tenantId, ambiente, numero])
  @@map("puntos_venta")
}

/// Un certificado activo por (tenant, ambiente). Los anteriores quedan con activo=false (historial).
/// Obligatorio en PRODUCCION. En HOMOLOGACION es opcional: sin certificado se usa el CUIT de prueba
/// de AfipSDK (como Vialto); con certificado se prueba con el CUIT real del tenant.
model CertificadoArca {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ambiente     AmbienteArca
  certCifrado  String // PEM cifrado (v1:iv:tag:cipher)
  claveCifrada String // PEM cifrado
  alias        String? // CN del certificado
  huellaSha256 String // fingerprint del cert (para mostrar, nunca el contenido)
  venceEl      DateTime
  activo       Boolean      @default(true)
  cargadoPorId String?
  createdAt    DateTime     @default(now())

  @@index([tenantId, ambiente, activo])
  @@map("certificados_arca")
}

model PlantillaPdf {
  tenantId         String   @id
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logo             Bytes? // ≤ 300 KB, PNG/JPG
  logoMime         String?
  colorPrimario    String   @default("#111827")
  colorSecundario  String   @default("#6B7280")
  textoPie         String?
  // Firma de los documentos que no van a ARCA (presupuestos, recibos, listados): "ATTE. ALEXIS NAHUEL HERMAN".
  firmaTexto       String?
  mostrarDuplicado Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("plantillas_pdf")
}

// ─────────────────────────────── Auth ───────────────────────────────

model Usuario {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String // normalizado a minúsculas
  nombre       String?
  passwordHash String? // null = solo entra por token de acceso de integración (Fase 4)
  activo       Boolean   @default(true)
  tokenVersion Int       @default(0) // incrementar invalida todas sus sesiones JWT
  creadoPor    String    @default("script") // script | registro | integracion:<id>
  ultimoAcceso DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tokensAcceso TokenAcceso[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([email])
  @@map("usuarios")
}

/// Un sistema integrado (tracker, Vialto, …) con UNA API key vigente; rotar = crear otra y revocar esta.
model Integracion {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre      String
  origen      OrigenItem @default(API) // origen con el que se registran sus ítems
  keyPrefijo  String     @unique // parte pública, ej. "fct_7Hk2pQ9x" (para buscar y mostrar)
  keyHash     String // SHA-256 (hex) de la clave completa
  scopes      String[] // items:write, comprobantes:write, comprobantes:read, acceso:emitir
  ultimoUsoEn DateTime?
  revocadaEn  DateTime?
  creadaPorId String?
  createdAt   DateTime   @default(now())

  tokensAcceso         TokenAcceso[]
  solicitudesIdem      SolicitudIdempotente[]
  webhookSuscripciones WebhookSuscripcion[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("integraciones")
}

// ─────────────────────────────── API pública ───────────────────────────────

/// Respuesta guardada por Idempotency-Key (24 h) para los POST de la API pública.
model SolicitudIdempotente {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integracionId String
  integracion   Integracion @relation(fields: [tenantId, integracionId], references: [tenantId, id], onDelete: Cascade)
  clave         String
  hashRequest   String // misma clave con otro request → 422
  estadoHttp    Int? // null = en curso
  respuesta     Json?
  createdAt     DateTime    @default(now())
  expiraEn      DateTime

  @@unique([tenantId, integracionId, clave])
  @@index([expiraEn])
  @@map("solicitudes_idempotentes")
}

model WebhookSuscripcion {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integracionId  String?
  integracion    Integracion? @relation(fields: [tenantId, integracionId], references: [tenantId, id], onDelete: Cascade)
  url            String
  eventos        String[] // comprobante.emitido, comprobante.rechazado, importacion.confirmada
  secretoCifrado String // para firmar HMAC-SHA256; reversible porque hay que firmar con él
  activa         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  entregas WebhookEntrega[]

  @@unique([tenantId, id])
  @@map("webhook_suscripciones")
}

model WebhookEntrega {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  suscripcionId  String
  suscripcion    WebhookSuscripcion   @relation(fields: [tenantId, suscripcionId], references: [tenantId, id], onDelete: Cascade)
  eventoId       String // id estable del evento: el receptor deduplica con esto
  evento         String
  payload        Json
  estado         EstadoWebhookEntrega @default(PENDIENTE)
  intentos       Int                  @default(0)
  proximoIntento DateTime             @default(now())
  ultimoStatus   Int?
  ultimoError    String?
  createdAt      DateTime             @default(now())
  entregadaEn    DateTime?

  @@unique([suscripcionId, eventoId])
  @@index([estado, proximoIntento])
  @@index([tenantId, suscripcionId, createdAt])
  @@map("webhook_entregas")
}

/// Token de un solo uso (60 s) para entrar al frontend desde un sistema integrado.
model TokenAcceso {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integracionId String
  integracion   Integracion @relation(fields: [tenantId, integracionId], references: [tenantId, id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario     @relation(fields: [tenantId, usuarioId], references: [tenantId, id], onDelete: Cascade)
  tokenHash     String      @unique
  destino       String? // path relativo validado, ej. "/importaciones"
  expiraEn      DateTime
  usadoEn       DateTime?
  createdAt     DateTime    @default(now())

  @@index([expiraEn])
  @@map("tokens_acceso")
}

// ─────────────────────────────── Clientes ───────────────────────────────

model Cliente {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  razonSocial        String
  tipoDocumento      TipoDocumento
  numeroDocumento    String // "0" para consumidor final anónimo o cliente sin documento
  // "TIPO:NUMERO" para que no se repita un documento en la empresa; null sin documento (puede haber varios).
  claveDocumento     String?
  condicionIva       CondicionIva
  domicilio          String?
  email              String?
  pais               String        @default("AR")
  monedaPreferida    Moneda        @default(ARS)
  diasVencimiento    Int? // para FchVtoPago en servicios
  activo             Boolean       @default(true)
  datosPadron        Json? // última respuesta de padrón (snapshot)
  padronConsultadoEn DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  referencias   ClienteReferenciaExterna[]
  tarifas       Tarifa[]
  items         ItemFacturable[]
  comprobantes  Comprobante[]
  recibos       Recibo[]
  movimientosCc MovimientoCuentaCorriente[]
  proyectos     Proyecto[]
  presupuestos  Presupuesto[]

  @@unique([tenantId, id])
  @@unique([tenantId, claveDocumento])
  @@index([tenantId, tipoDocumento, numeroDocumento])
  @@map("clientes")
}

/// Mapea el id de un cliente en un sistema externo (ej. clients.id del tracker) al Cliente de Faktia.
model ClienteReferenciaExterna {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId         String
  cliente           Cliente    @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Cascade)
  origen            OrigenItem
  referenciaExterna String
  createdAt         DateTime   @default(now())

  @@unique([tenantId, origen, referenciaExterna])
  @@map("clientes_referencias_externas")
}

/// Tarifa por cliente (y opcionalmente por proyecto/clave externa). La más específica vigente gana.
model Tarifa {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId      String
  cliente        Cliente     @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Cascade)
  origen         OrigenItem? // null = aplica a cualquier origen
  claveExterna   String? // ej. id del proyecto en el tracker; null = todo el cliente
  descripcion    String? // texto para la línea; admite {proyecto} y {periodo}
  unidad         UnidadItem
  precioUnitario Decimal     @db.Decimal(15, 4)
  moneda         Moneda
  alicuotaIva    Decimal     @db.Decimal(5, 2)
  vigenteDesde   DateTime    @db.Date
  vigenteHasta   DateTime?   @db.Date
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([tenantId, clienteId, vigenteDesde])
  @@map("tarifas")
}

// ─────────────────────────────── Importaciones ───────────────────────────────

model PlantillaMapeo {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  formato   String // "xlsx" | "csv"
  config    Json // PlantillaMapeoConfig (ARCHITECTURE.md §7.4)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importaciones Importacion[]

  @@unique([tenantId, id])
  @@unique([tenantId, nombre])
  @@map("plantillas_mapeo")
}

/// Un lote de ingreso (archivo, request de API, carga manual).
model Importacion {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  origen           OrigenItem
  estado           EstadoImportacion @default(EN_STAGING)
  descripcion      String? // nombre de archivo, lote de la API, etc.
  archivoSha256    String? // detectar el mismo archivo subido dos veces
  plantillaMapeoId String?
  plantillaMapeo   PlantillaMapeo?   @relation(fields: [tenantId, plantillaMapeoId], references: [tenantId, id], onDelete: Restrict)
  integracionId    String?
  parametros       Json? // parámetros del ingreso, si los hubo
  advertencias     Json? // [{ referencia?, mensaje }] del adaptador
  totalItems       Int               @default(0)
  validos          Int               @default(0)
  conErrores       Int               @default(0)
  duplicados       Int               @default(0)
  actualizados     Int               @default(0)
  creadaPorId      String?
  createdAt        DateTime          @default(now())
  confirmadaEn     DateTime?

  items ItemFacturable[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("importaciones")
}

/// Modelo canónico de entrada (ARCHITECTURE.md §6).
model ItemFacturable {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importacionId String?
  importacion   Importacion? @relation(fields: [tenantId, importacionId], references: [tenantId, id], onDelete: Restrict)

  origen            OrigenItem
  referenciaExterna String // id en el sistema de origen; para MANUAL lo genera el frontend

  // Cliente: resuelto (clienteId) o datos para resolverlo
  clienteId                String?
  cliente                  Cliente?       @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Restrict)
  clienteTipoDocumento     TipoDocumento?
  clienteNumeroDocumento   String?
  clienteReferenciaExterna String?
  clienteAlta              Json? // datos sugeridos para crear el cliente si no existe

  descripcion    String
  cantidad       Decimal    @db.Decimal(15, 4)
  unidad         UnidadItem
  precioUnitario Decimal    @db.Decimal(15, 4)
  moneda         Moneda     @default(ARS)
  alicuotaIva    Decimal    @db.Decimal(5, 2)
  fecha          DateTime?  @db.Date
  periodoDesde   DateTime?  @db.Date
  periodoHasta   DateTime?  @db.Date
  metadatos      Json? // libre por fuente (proyecto, horas trabajadas y facturables, …)

  estado        EstadoItem @default(VALIDO)
  errores       Json? // [{ campo, mensaje }]
  hashContenido String // detecta "misma referencia, contenido distinto"

  comprobanteId String?
  comprobante   Comprobante? @relation(fields: [tenantId, comprobanteId], references: [tenantId, id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineas ComprobanteLinea[]

  @@unique([tenantId, id])
  @@unique([tenantId, origen, referenciaExterna]) // idempotencia de importación
  @@index([tenantId, estado])
  @@index([tenantId, clienteId, estado])
  @@index([tenantId, importacionId])
  @@map("items_facturables")
}

// ─────────────────────────────── Comprobantes ───────────────────────────────

model Comprobante {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo     TipoComprobante
  estado   EstadoComprobante @default(BORRADOR)
  ambiente AmbienteArca // snapshot del ambiente al crear/emitir

  clienteId    String
  cliente      Cliente    @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Restrict)
  puntoVentaId String
  puntoVenta   PuntoVenta @relation(fields: [tenantId, puntoVentaId], references: [tenantId, id], onDelete: Restrict)

  // Numeración: se reserva justo antes de llamar a ARCA (ver ARCHITECTURE.md §8.3)
  numero          Int?
  numeroReservado Int?

  fechaEmision       DateTime     @db.Date
  concepto           ConceptoArca
  fechaServicioDesde DateTime?    @db.Date
  fechaServicioHasta DateTime?    @db.Date
  fechaVtoPago       DateTime?    @db.Date

  moneda             Moneda  @default(ARS)
  cotizacion         Decimal @default(1) @db.Decimal(15, 6)
  cancelaMismaMoneda Boolean @default(false) // CanMisMonExt, solo moneda extranjera

  importeNetoGravado Decimal @default(0) @db.Decimal(15, 2)
  importeNoGravado   Decimal @default(0) @db.Decimal(15, 2)
  importeExento      Decimal @default(0) @db.Decimal(15, 2)
  importeIva         Decimal @default(0) @db.Decimal(15, 2)
  importeTributos    Decimal @default(0) @db.Decimal(15, 2)
  importeTotal       Decimal @default(0) @db.Decimal(15, 2)

  // Snapshots para PDF y auditoría (el comprobante emitido no cambia si cambian el cliente o el tenant)
  emisorSnapshot   Json?
  receptorSnapshot Json?

  // NC/ND: comprobante asociado (CbtesAsoc)
  asociadoId     String?
  asociado       Comprobante?  @relation("Asociacion", fields: [tenantId, asociadoId], references: [tenantId, id], onDelete: Restrict)
  asociadosDesde Comprobante[] @relation("Asociacion")
  motivo         String?

  observaciones     String? // texto libre que va al PDF
  // Proyecto (obra) al que corresponde: la cuenta corriente aplica su modo de IVA (ModoIvaProyecto).
  proyectoId        String?
  proyecto          Proyecto? @relation(fields: [tenantId, proyectoId], references: [tenantId, id], onDelete: Restrict)
  cae               String?
  caeVencimiento    DateTime? @db.Date
  observacionesArca Json?
  errorMensaje      String?
  errorDetalle      String?

  idempotencyKey String? // del botón "Emitir" o de la API pública
  payloadHash    String? // hash del request a ARCA del último intento
  intentos       Int     @default(0)
  version        Int     @default(0) // lock optimista para edición

  creadoPorId  String?
  emitidoPorId String?
  emitidoEn    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lineas       ComprobanteLinea[]
  alicuotas    ComprobanteAlicuota[]
  arcaLogs     ArcaLog[]
  items        ItemFacturable[]
  movimientoCc MovimientoCuentaCorriente?

  @@unique([tenantId, id])
  @@unique([tenantId, ambiente, puntoVentaId, tipo, numero]) // Postgres permite múltiples NULL
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, estado])
  @@index([tenantId, clienteId])
  @@index([estado, updatedAt])
  @@map("comprobantes")
}

// ─────────────────────────────── Recibos ───────────────────────────────

enum TipoRecibo {
  COBRO // un cliente le paga al tenant
  PAGO // el tenant le paga a un colaborador o proveedor
}

/// Recibo creado desde Faktia (no va a ARCA). Se guarda lo que hace falta para regenerar el PDF:
/// el PDF se arma a pedido con la plantilla vigente. Aparece en el listado de comprobantes.
model Recibo {
  id                    String     @id @default(cuid())
  tenantId              String
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo                  TipoRecibo
  numero                String? // lo pone el usuario ("0001-00000001"); único por tenant y tipo
  fecha                 DateTime   @db.Date
  moneda                Moneda     @default(ARS)
  total                 Decimal    @db.Decimal(15, 2)
  // Solo en COBRO, si se eligió un cliente cargado (la contraparte igual queda en el snapshot).
  clienteId             String?
  cliente               Cliente?   @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Restrict)
  contraparteNombre     String // quien paga (COBRO) o cobra (PAGO): columna aparte para ordenar el listado
  contraparte           Json // { nombre, documento?, domicilio? }
  items                 Json // [{ descripcion, cantidad?, importe }]
  comprobantesAplicados Json? // solo COBRO: [{ descripcion, importe }]
  periodo               String? // solo PAGO
  medioPago             String?
  observaciones         String?
  // Entrega de un proyecto: el pago se imputa a las deudas de ese proyecto y el PDF muestra su estado.
  proyectoId            String?
  proyecto              Proyecto?  @relation(fields: [tenantId, proyectoId], references: [tenantId, id], onDelete: Restrict)
  // Copia del estado del proyecto al guardar el recibo (EstadoProyectoRecibo): el PDF muestra el saldo de esa fecha.
  estadoProyecto        Json?
  // Pago en otra moneda que la deuda: cuánto cancela en la moneda del proyecto y con qué tipo de cambio.
  monedaImputacion      Moneda?
  importeImputacion     Decimal?   @db.Decimal(15, 2)
  tipoCambio            Decimal?   @db.Decimal(15, 6)
  // Anular no borra: la cuenta corriente revierte el cobro con un movimiento de anulación.
  anuladoEn             DateTime?
  motivoAnulacion       String?
  creadoPorId           String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  movimientoCc MovimientoCuentaCorriente?

  @@unique([tenantId, id])
  @@unique([tenantId, tipo, numero]) // Postgres permite múltiples NULL
  @@index([tenantId, fecha])
  @@index([tenantId, clienteId])
  @@index([tenantId, proyectoId])
  @@map("recibos")
}

// ─────────────────────────────── Cuenta corriente ───────────────────────────────

enum TipoMovimientoCc {
  DEBE // lo que el cliente debe: factura, nota de débito, saldo inicial o ajuste
  HABER // lo que lo cancela: cobro (recibo), nota de crédito o ajuste a su favor
}

enum OrigenMovimientoCc {
  COMPROBANTE // factura / ND (DEBE) o NC (HABER) emitida: la crea la sincronización
  RECIBO // recibo de cobro guardado con un cliente: la crea la sincronización
  MANUAL // cargado desde Cuenta corriente (saldo inicial, ajuste, cobro sin recibo) o adicional de un proyecto
  ACUERDO // hito del monto acordado de un proyecto (DEBE)
  ANULACION // revierte un cobro de un recibo anulado (DEBE imputado a ese HABER)
}

enum EstadoProyecto {
  EN_CURSO
  FINALIZADO
  CANCELADO
}

/// Cómo impactan en la cuenta corriente las facturas de un proyecto con monto acordado.
enum ModoIvaProyecto {
  MAS_IVA // la factura suma solo su IVA y tributos (el neto ya está en el acordado); una NC los resta
  ACORDADO_FINAL // la factura no suma nada: el acordado ya es el precio final
}

/// Un renglón de la cuenta corriente de un cliente (como Vialto). Los de comprobantes y recibos
/// los crea la sincronización (CuentaCorrienteService.sincronizar), nunca se editan a mano salvo el
/// vencimiento. Lo pendiente de cada uno no se guarda: sale de las imputaciones.
model MovimientoCuentaCorriente {
  id               String                      @id @default(cuid())
  tenantId         String
  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId        String
  cliente          Cliente                     @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Restrict)
  tipo             TipoMovimientoCc
  origen           OrigenMovimientoCc
  comprobanteId    String?
  comprobante      Comprobante?                @relation(fields: [tenantId, comprobanteId], references: [tenantId, id], onDelete: Cascade)
  reciboId         String?
  recibo           Recibo?                     @relation(fields: [tenantId, reciboId], references: [tenantId, id], onDelete: Cascade)
  concepto         String // "Factura A", "Recibo de cobro", "Saldo inicial"…
  numero           String? // número del comprobante, recibo o referencia externa
  moneda           Moneda
  importe          Decimal                     @db.Decimal(15, 2) // siempre positivo; el tipo dice el signo
  fecha            DateTime                    @db.Date
  fechaVencimiento DateTime?                   @db.Date // solo DEBE
  observaciones    String?
  // Proyecto (obra). Un HABER con proyecto se imputa solo a DEBE de ese proyecto; sin proyecto, solo a DEBE sin proyecto.
  proyectoId       String?
  proyecto         Proyecto?                   @relation(fields: [tenantId, proyectoId], references: [tenantId, id], onDelete: Restrict)
  // Hitos (origen ACUERDO): orden en el plan de pagos y si se cobra por certificaciones de avance.
  orden            Int?
  porCertificacion Boolean                     @default(false)
  // Pago en otra moneda: lo que entró (moneda e importe) y el tipo de cambio usado. `importe` está en `moneda`.
  monedaOrigen     Moneda?
  importeOrigen    Decimal?                    @db.Decimal(15, 2)
  tipoCambio       Decimal?                    @db.Decimal(15, 6)
  // Origen ANULACION: el HABER (cobro de un recibo anulado) que revierte.
  anulaId          String?
  anula            MovimientoCuentaCorriente?  @relation("Anulacion", fields: [tenantId, anulaId], references: [tenantId, id], onDelete: Cascade)
  anuladoPor       MovimientoCuentaCorriente[] @relation("Anulacion")
  creadoPorId      String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  imputacionesComoDebe  ImputacionCuentaCorriente[] @relation("ImputacionDebe")
  imputacionesComoHaber ImputacionCuentaCorriente[] @relation("ImputacionHaber")
  certificaciones       CertificacionHito[]

  @@unique([tenantId, id])
  @@unique([tenantId, comprobanteId])
  @@unique([tenantId, reciboId])
  @@index([tenantId, proyectoId])
  @@index([tenantId, clienteId, fecha])
  @@map("movimientos_cuenta_corriente")
}

/// Cuánto de un HABER (cobro, NC) se aplica a un DEBE (factura) puntual. Misma cuenta y moneda.
model ImputacionCuentaCorriente {
  id          String                    @id @default(cuid())
  tenantId    String
  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  haberId     String
  haber       MovimientoCuentaCorriente @relation("ImputacionHaber", fields: [tenantId, haberId], references: [tenantId, id], onDelete: Cascade)
  debeId      String
  debe        MovimientoCuentaCorriente @relation("ImputacionDebe", fields: [tenantId, debeId], references: [tenantId, id], onDelete: Cascade)
  importe     Decimal                   @db.Decimal(15, 2)
  automatica  Boolean                   @default(false) // la hizo la sincronización (NC a su factura, recibo a las facturas que cancela)
  creadoPorId String?
  createdAt   DateTime                  @default(now())

  @@unique([tenantId, haberId, debeId])
  @@index([tenantId, debeId])
  @@map("imputaciones_cuenta_corriente")
}

// ─────────────────────────────── Proyectos ───────────────────────────────

/// Un trabajo para un cliente (en pantalla, con la etiqueta de la empresa: "Obra"). El monto acordado
/// se divide en hitos, que son DEBE de la cuenta corriente (origen ACUERDO). No guarda saldos: salen
/// de los movimientos.
model Proyecto {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteId      String
  cliente        Cliente         @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Restrict)
  nombre         String
  ubicacion      String?
  estado         EstadoProyecto  @default(EN_CURSO)
  moneda         Moneda          @default(ARS)
  montoAcordado  Decimal?        @db.Decimal(15, 2) // null: sin acordado (las facturas suman su total)
  modoIva        ModoIvaProyecto @default(MAS_IVA)
  tipoCambioFijo Decimal?        @db.Decimal(15, 6) // pesos por dólar; gana sobre la cotización de ARCA
  fechaInicio    DateTime?       @db.Date
  fechaFin       DateTime?       @db.Date
  observaciones  String?
  creadoPorId    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  movimientosCc MovimientoCuentaCorriente[]
  comprobantes  Comprobante[]
  recibos       Recibo[]
  presupuestos  Presupuesto[]

  @@unique([tenantId, id])
  @@unique([tenantId, clienteId, nombre])
  @@index([tenantId, estado])
  @@map("proyectos")
}

/// Avance certificado de un hito "por certificación": la parte exigible del hito (vencimientos,
/// avisos e imputaciones trabajan sobre esto). La suma no supera el importe del hito.
model CertificacionHito {
  id               String                    @id @default(cuid())
  tenantId         String
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hitoId           String
  hito             MovimientoCuentaCorriente @relation(fields: [tenantId, hitoId], references: [tenantId, id], onDelete: Cascade)
  fecha            DateTime                  @db.Date
  descripcion      String
  importe          Decimal                   @db.Decimal(15, 2)
  fechaVencimiento DateTime?                 @db.Date
  creadoPorId      String?
  createdAt        DateTime                  @default(now())

  @@unique([tenantId, id])
  @@index([tenantId, hitoId])
  @@map("certificaciones_hito")
}

model ComprobanteLinea {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comprobanteId    String
  comprobante      Comprobante     @relation(fields: [tenantId, comprobanteId], references: [tenantId, id], onDelete: Cascade)
  orden            Int
  descripcion      String
  cantidad         Decimal         @db.Decimal(15, 4)
  unidad           UnidadItem
  precioUnitario   Decimal         @db.Decimal(15, 4)
  bonificacionPct  Decimal         @default(0) @db.Decimal(5, 2)
  alicuotaIva      Decimal         @db.Decimal(5, 2) // 0, 2.5, 5, 10.5, 21, 27 (en C se guarda y no se discrimina)
  importeNeto      Decimal         @db.Decimal(15, 2)
  importeIva       Decimal         @db.Decimal(15, 2)
  importeTotal     Decimal         @db.Decimal(15, 2)
  itemFacturableId String?
  itemFacturable   ItemFacturable? @relation(fields: [tenantId, itemFacturableId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, comprobanteId])
  @@map("comprobante_lineas")
}

/// AlicIva enviado a ARCA (Id, BaseImp, Importe) — ya agrupado por alícuota.
model ComprobanteAlicuota {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comprobanteId String
  comprobante   Comprobante @relation(fields: [tenantId, comprobanteId], references: [tenantId, id], onDelete: Cascade)
  arcaId        Int // 3=0%, 9=2.5%, 8=5%, 4=10.5%, 5=21%, 6=27%
  baseImponible Decimal     @db.Decimal(15, 2)
  importe       Decimal     @db.Decimal(15, 2)

  @@unique([tenantId, comprobanteId, arcaId])
  @@map("comprobante_alicuotas")
}

/// Auditoría de cada llamada a ARCA. Nunca guarda token/sign/cert/clave.
model ArcaLog {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comprobanteId String?
  comprobante   Comprobante? @relation(fields: [tenantId, comprobanteId], references: [tenantId, id], onDelete: Restrict)
  metodo        String // FECompUltimoAutorizado | FECAESolicitar | FECompConsultar | …
  ambiente      AmbienteArca
  request       Json // saneado
  response      Json?
  exitoso       Boolean
  error         String?
  duracionMs    Int
  createdAt     DateTime     @default(now())

  @@index([tenantId, comprobanteId])
  @@index([tenantId, createdAt])
  @@map("arca_logs")
}

// ─────────────────────────────── Avisos ───────────────────────────────

/// Resumen diario de vencimientos enviado (uno por empresa y día: el job no lo repite si se reinicia).
model AvisoEmail {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fecha         DateTime @db.Date
  destinatarios String[]
  vencidos      Int
  proximos      Int
  transporte    String // smtp | log
  createdAt     DateTime @default(now())

  @@unique([tenantId, fecha])
  @@map("avisos_email")
}

// ─────────────────────────────── Presupuestos ───────────────────────────────

enum EstadoPresupuesto {
  BORRADOR // editable
  ENVIADO // ya se mandó al cliente: no se edita (se duplica)
  ACEPTADO // puede crear un proyecto
  RECHAZADO
  VENCIDO // pasó la fecha de vencimiento sin aceptarse ni rechazarse
}

enum FormaCotizar {
  POR_ITEM // cada ítem con su importe; el total es la suma
  GLOBAL // varios trabajos y un solo total
  SUPERFICIE // medidas, metros cuadrados a cubrir e importe
}

enum IvaPresupuesto {
  SIN_IVA // no se menciona el IVA
  NO_INCLUYE // se aclara "no incluye IVA"
  DISCRIMINADO // subtotal, IVA y total con IVA
}

/// Presupuesto (no es comprobante fiscal: no va a ARCA ni genera deuda). Numeración P-0000001 por empresa.
model Presupuesto {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero           Int
  fecha            DateTime          @db.Date
  fechaVencimiento DateTime          @db.Date
  estado           EstadoPresupuesto @default(BORRADOR)
  clienteId        String
  cliente          Cliente           @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Restrict)
  titulo           String? // "Cubierta de galpón"
  lugar            String? // obra o lugar del trabajo
  moneda           Moneda            @default(ARS)
  formaCotizar     FormaCotizar      @default(POR_ITEM)
  // Solo SUPERFICIE: { ancho, largo, alturaLateral?, alturaCumbrera?, metrosCuadrados, precioMetroCuadrado? } (strings decimales).
  superficie       Json?
  importeGlobal    Decimal?          @db.Decimal(15, 2) // GLOBAL y SUPERFICIE sin precio por m²
  ivaModo          IvaPresupuesto    @default(NO_INCLUYE)
  alicuotaIva      Decimal           @default(21) @db.Decimal(5, 2)
  subtotal         Decimal           @default(0) @db.Decimal(15, 2)
  iva              Decimal           @default(0) @db.Decimal(15, 2)
  total            Decimal           @default(0) @db.Decimal(15, 2)
  // Observaciones elegidas del catálogo, copiadas: [{ texto, valor? }].
  observaciones    Json              @default("[]")
  notas            String? // texto libre que va antes de las observaciones
  // Copias al guardar mientras es borrador: cambiar el cliente o la empresa después no lo modifica.
  clienteSnapshot  Json
  emisorSnapshot   Json
  proyectoId       String? // proyecto creado desde este presupuesto aceptado
  proyecto         Proyecto?         @relation(fields: [tenantId, proyectoId], references: [tenantId, id], onDelete: Restrict)
  duplicadoDeId    String?
  creadoPorId      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items PresupuestoItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@index([tenantId, clienteId])
  @@map("presupuestos")
}

model PresupuestoItem {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [tenantId, presupuestoId], references: [tenantId, id], onDelete: Cascade)
  orden         Int
  cantidad      String? // texto: "1", "120 m²", "4"
  descripcion   String // con formato limitado (HTML saneado: p, b, i, u y colores de la paleta)
  importe       Decimal?    @db.Decimal(15, 2) // solo POR_ITEM: total del renglón

  @@index([tenantId, presupuestoId])
  @@map("presupuesto_items")
}

/// Ítem frecuente: plantilla que se copia al presupuesto (editarlo ahí no cambia la biblioteca).
model ItemBiblioteca {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  titulo      String
  descripcion String // con formato limitado
  categoria   String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, titulo])
  @@map("items_biblioteca")
}

/// Observación del catálogo. `texto` puede llevar {valor} donde va lo que se completa (ej. "Plazo de obra: {valor}").
model ObservacionCatalogo {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  texto         String
  llevaValor    Boolean  @default(false)
  valorSugerido String?
  porDefecto    Boolean  @default(false) // viene tildada en un presupuesto nuevo
  orden         Int      @default(0)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, texto])
  @@map("observaciones_catalogo")
}
